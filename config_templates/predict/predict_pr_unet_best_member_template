#-------------------------#
# BEST-MEMBER PARAMETERS  #
#-------------------------#
# Transform used only for member scoring. "log1p" reduces the dominance of
# very large precipitation values; "none" scores in physical units.
BEST_MEMBER_TRANSFORM="log1p"

# Quantile across ensemble members used as the reference field. For each day,
# every full sample map is compared against this reference map. Lower values
# such as 0.20/0.30 favor drier, less extreme members; 0.50 is the median map.
BEST_MEMBER_REFERENCE_QUANTILE=0.20

# Spatial tail statistic used to judge whether a sample map has enough intense
# precipitation. 0.98 means the p98 value over all high-resolution grid cells.
BEST_MEMBER_TAIL_QUANTILE=0.98

# Target rank for the tail statistic across ensemble members. 0.75 means the
# desired tail is around the 75th percentile of the candidate members' tails.
BEST_MEMBER_TAIL_TARGET=0.75

# Penalty weight for samples whose tail is weaker than the target tail.
# Set to 0.00 for pure closeness-only member selection.
BEST_MEMBER_TAIL_WEIGHT=0.50

# Penalty weight for samples whose tail is stronger than the target tail.
# Useful if false extreme rain appears too often; 0.00 leaves high tails unpenalized.
BEST_MEMBER_TAIL_EXCESS_WEIGHT=0.00

# Closeness-only selection:
# BEST_MEMBER_TAIL_WEIGHT=0.00
# BEST_MEMBER_TAIL_EXCESS_WEIGHT=0.00

